# =============================================================================
# .env.example — copy to .env and fill in your values
# This file is committed to version control. Never commit .env directly.
# =============================================================================

# =============================================================================
# 1Password CLI (REQUIRED)
# Used by scripts/inject-tfvars.sh to inject secrets into *.tfvars files.
# Obtain a Service Account Token from:
#   https://developer.1password.com/docs/service-accounts/get-started/
# =============================================================================
OP_SERVICE_ACCOUNT_TOKEN=your-1password-service-account-token-here

# =============================================================================
# LocalStack (OPTIONAL — overrides docker-compose.localstack.yml defaults)
# Only set these if you need values different from the defaults shown below.
# =============================================================================

# Debug mode (0=off, 1=on). Default: 0
# DEBUG=0

# Lambda executor. Default: docker
# LAMBDA_EXECUTOR=docker

# AWS services to enable (comma-separated or "all").
# Default: s3,dynamodb,lambda,ec2,iam,sts,cloudformation,apigateway,sqs,sns,cloudwatch
# SERVICES=s3,dynamodb,lambda,ec2,iam,sts,cloudformation,apigateway,sqs,sns,cloudwatch

# Enable LocalStack persistence (0=off, 1=on). Default: 0
# PERSISTENCE=0

# Directory for LocalStack persistent data. Default: ./volume
# LOCALSTACK_VOLUME_DIR=./volume
